# Backend Dockerfile for FastAPI service (TA v1.0.0-preview)
# 前后端分离架构 - 后端服务
# 支持多架构: amd64, arm64

# 多阶段构建：构建阶段
FROM python:3.10-slim-bookworm AS builder

# 获取构建架构信息
ARG TARGETARCH

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=Asia/Shanghai \
    LANG=zh_CN.UTF-8 \
    LC_ALL=zh_CN.UTF-8 \
    LANGUAGE=zh_CN.UTF-8 \
    PYTHONIOENCODING=utf-8

WORKDIR /app

# 简化版：只安装必要的系统依赖，移除可能导致构建问题的复杂包
RUN echo 'Acquire::Retries "3";' > /etc/apt/apt.conf.d/80-retries && \
    echo 'Acquire::http::Timeout "30";' >> /etc/apt/apt.conf.d/80-retries && \
    echo 'Acquire::https::Timeout "30";' >> /etc/apt/apt.conf.d/80-retries && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gcc \
        libc6-dev \
        wget && \
    rm -rf /var/lib/apt/lists/*

# 复制pyproject.toml和README.md（pip安装需要）
COPY pyproject.toml README.md ./

# 安装Python依赖
# 优化说明：
# 1. 使用清华镜像加速下载
# 2. 优先使用预编译的二进制wheel包（--prefer-binary）
# 3. 避免从源码编译，大幅提升ARM架构构建速度
# 4. 安装 PDF 导出工具: pdfkit
# 5. 安装 Scrapy 爬虫框架
RUN pip install --upgrade pip -i https://pypi.tuna.tsinghua.edu.cn/simple && \
    pip install --prefer-binary . -i https://pypi.tuna.tsinghua.edu.cn/simple && \
    pip install --prefer-binary pdfkit scrapy -i https://pypi.tuna.tsinghua.edu.cn/simple

# 多阶段构建：运行阶段
FROM python:3.10-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=Asia/Shanghai

WORKDIR /app

# 创建必需的目录
RUN mkdir -p /app/logs /app/data /app/config /app/scripts

# 安装运行时依赖和中文语言支持
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        fontconfig \
        libfontconfig1 \
        wget \
        locales \
        locales-all && \
    rm -rf /var/lib/apt/lists/*

# 从构建阶段复制Python依赖
COPY --from=builder /usr/local/lib/python3.10/site-packages /usr/local/lib/python3.10/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# 复制后端代码和必需模块（只复制运行时需要的目录）
COPY app ./app
COPY tradingagents ./tradingagents
COPY config ./config
COPY scripts/setup ./scripts/setup
COPY scripts/user_password_manager.py ./scripts/
COPY scripts/mongo-init.js ./scripts/
COPY docs/fjzt_a.csv ./docs/
COPY app/scrapy_project ./app/scrapy_project

# 复制Docker环境配置文件
COPY .env.docker ./.env

# 暴露后端端口（与docker-compose.yml一致）
EXPOSE 8000

# Docker环境标识
ENV DOCKER_CONTAINER=true

# 启动FastAPI服务
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]